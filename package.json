{
  "name": "secp256k1-db-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm build && pnpm -r test",
    "test:live": "pnpm --filter secp256k1-db-server test:live",
    "dev:cf": "pnpm --filter secp256k1-db-cf-worker dev",
    "dev:node": "pnpm --filter secp256k1-db dev",
    "deploy": "pnpm --filter secp256k1-db-cf-worker deploy",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check"
  }
}
