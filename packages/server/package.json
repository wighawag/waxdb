{
	"name": "@waxdb/server",
	"version": "0.1.0",
	"description": "platform-agnostic secp256k1-authenticated key-value server",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wighawag/waxdb.git",
		"directory": "packages/server"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/esm/index.d.ts",
			"default": "./dist/esm/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src"
	],
	"dependencies": {
		"@noble/curves": "^2.3.0",
		"@noble/hashes": "^2.3.0",
		"hono": "^4.6.13",
		"named-logs": "^0.3.2"
	},
	"devDependencies": {
		"@ethersproject/wallet": "^5.8.0",
		"as-soon": "^0.0.11",
		"prettier": "^3.4.2",
		"typescript": "^5.6.3",
		"vitest": "^4.1.11"
	},
	"scripts": {
		"build": "tsc --project tsconfig.json",
		"dev": "as-soon -w src pnpm build",
		"test": "vitest run --exclude '**/live.conformance.test.ts' --exclude '**/node_modules/**'",
		"test:watch": "vitest",
		"test:live": "vitest run test/live.conformance.test.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"vectors": "node scripts/generate-vectors.mjs"
	}
}
