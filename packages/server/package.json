{
  "name": "waxdb-server",
  "version": "0.0.1",
  "description": "platform-agnostic secp256k1-authenticated key-value server",
  "license": "AGPL-3.0-only",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@ethersproject/wallet": "^5.0.0",
    "hono": "^4.6.13",
    "named-logs": "^0.3.2"
  },
  "devDependencies": {
    "as-soon": "^0.0.11",
    "prettier": "^3.4.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "as-soon -w src pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run test/live.conformance.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  }
}
